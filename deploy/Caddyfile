# In-container Caddy for task.geterdone.io. Plain HTTP on :8080; the host
# Caddy terminates TLS and proxies here.
{
	admin off
	auto_https off
	persist_config off
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		# No inline script anywhere. connect-src covers Microsoft sign-in, Graph,
		# and the pre-authenticated upload URLs Graph hands out for large files.
		Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; font-src 'self'; manifest-src 'self'; connect-src 'self' https://login.microsoftonline.com https://graph.microsoft.com https://*.sharepoint.com https://api.onedrive.com https://*.1drv.com https://*.microsoftpersonalcontent.com https://outlook.office.com https://outlook.office365.com"
	}
}

:8080 {
	log {
		output stdout
	}
	root * /srv
	encode zstd gzip
	import security_headers

	# HTML and modules revalidate on every load so a release is picked up at once.
	header Cache-Control "no-cache"
	@icons path /favicon.svg
	header @icons Cache-Control "public, max-age=86400"
	@callback path /oauth2/spa/callback/*
	header @callback Cache-Control "no-store"

	handle /healthz {
		log_skip
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		respond "ok" 200
	}
	handle /release.txt {
		log_skip
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle {
		try_files {path} {path}/index.html /index.html
		file_server {
			index index.html
		}
	}
	handle_errors {
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
